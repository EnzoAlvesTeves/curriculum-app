<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CurriculumApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CurriculumApp"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.signup.SignUpActivity"
            android:exported="false" />

        <activity
            android:name=".ui.forgotpassword.ForgotPasswordActivity"
            android:exported="false" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <activity
            android:name=".ui.empresa.CreateEmpresaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.empresa.ListEmpresasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.empresa.EditEmpresaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.vaga.CreateVagaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.vaga.ListVagasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.vaga.EditVagaActivity"
            android:exported="false" />

        <activity
            android:name=".ui.candidato.VagasPublicasActivity"
            android:exported="false" />

        <activity
            android:name=".ui.candidato.CurriculoActivity"
            android:exported="false" />

        <activity
            android:name=".ui.candidato.MinhasCandidaturasActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>
